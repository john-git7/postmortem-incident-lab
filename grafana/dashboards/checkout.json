{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Checkout API — Service Health",
  "uid": "checkout-health",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Deployed Revision",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "checkout_app_info",
          "legendFormat": "{{revision}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate (by status)",
      "gridPos": { "h": 9, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum by (status) (rate(checkout_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Checkout Latency p95 (s)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(checkout_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    }
  ],
  "__comment_missing_panel": "INTENTIONAL GAP: there is no 'Error Rate (%)' panel on this dashboard. During the incident the request-rate panel shows total traffic but you cannot see the error ratio at a glance — you must dig into container logs to detect the failures. Adding an error-rate panel is a valid prevention item.",
  "templating": { "list": [] }
}
